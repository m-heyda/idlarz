#!/bin/sh
# Regenerates the asset catalog and stages it. Installed by `npm install` (the `prepare` script sets core.hooksPath to .githooks). Skip it for one commit with `git commit --no-verify`.
npm run --silent assets:catalog || {
	echo "pre-commit: assets:catalog failed (skip with --no-verify)" >&2
	exit 1
}
git add docs/assets
