#!/bin/sh
# Runs `npm run verify` (everything CI checks, on all your cores) before a push, so CI only has to confirm it. Skipped for pushes that only delete a branch or tag.
# Skip it once with `SKIP_VERIFY=1 git push` or `git push --no-verify` (CI still fails what you skipped). Installed by `npm install` (the `prepare` script).
[ -n "$SKIP_VERIFY" ] && exit 0
pushing=0
while read -r _ local_sha _ _; do
	[ "$local_sha" != "0000000000000000000000000000000000000000" ] && pushing=1
done
[ "$pushing" = 1 ] || exit 0
npm run --silent verify || {
	echo "pre-push: verify failed (fix it, or skip once with SKIP_VERIFY=1 git push)" >&2
	exit 1
}
