# Server-only (no NEXT_PUBLIC_): the browser never talks to Supabase, the /api/auth routes do.
# Project URL and the publishable (anon) key from Supabase > Settings > API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Needed for the cloud save: only the /api/save route may write the player_saves table.
# Supabase > Settings > API Keys > secret key. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only and REQUIRED: without it the game cannot be played (spawns, chests, kills and every fight are sealed with it).
# Seals chest and kill rolls (and decides lucky monsters, monster tiles and every fight roll) so a browser can neither predict nor re-roll them
# (docs/11-offline-and-sealed-rolls.md). 16+ characters; the value below is the shared one every new workspace starts with (the repo is private).
# Never prefix with NEXT_PUBLIC_.
LOOT_SECRET=6dh5djshfdy3i8sn
