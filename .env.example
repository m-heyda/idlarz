# Server-only (no NEXT_PUBLIC_): the browser never talks to Supabase, the /api/auth routes do.
# Project URL and the publishable (anon) key from Supabase > Settings > API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Needed for the cloud save: only the /api/save route may write the player_saves table.
# Supabase > Settings > API Keys > secret key. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only and REQUIRED: without it the spawn, chest, fight and offline routes answer 503 and nothing in the game can happen.
# Seals chest and kill rolls (and decides golden monsters, monster tiles and every fight roll) so a browser can neither predict nor re-roll them
# (docs/reference/saves-and-server.md). 16+ characters, and EVERY deployment (local, preview, production) gets its own: the repo is public, so never
# reuse a value that has been committed anywhere. Generate one with
#   node -p "require('crypto').randomBytes(24).toString('hex')"
# Changing it only changes what the next rewards roll (nothing stored depends on it). Never prefix with NEXT_PUBLIC_, never commit a real value.
LOOT_SECRET=

# Optional, server-only. The site's own address(es) for the link in the password-reset email, comma-separated: the first is the default, and the email links back
# to the one the player is on when it is listed (a Host header can never add one). Empty = the Vercel deployment host, else the request's own origin (local dev).
# Every origin listed here must ALSO be in Supabase > Authentication > URL Configuration > Redirect URLs (as https://<host>/**), or Supabase ignores the redirect.
# localhost is listed so a local run links back to localhost instead of production (also add http://localhost:3000/** to the Supabase Redirect URLs).
SITE_URL=https://idler.site,https://www.idler.site,https://idler-rose.vercel.app,http://localhost:3000

# Optional, server-only. The user id (Supabase auth uuid) of the one account that is given the special pet Yuki and her welcome letter at its next login (the pets route compares ids, never names). Empty = nobody gets it.
# Never prefix with NEXT_PUBLIC_: the id stays on the server.
YUKI_GRANT_USER_ID=

# Optional. The tutorial guide (Brother Alder) is shown on localhost and on Vercel previews and, on the production site, only after the new chapter release (GAME_EPOCH raised).
# NEXT_PUBLIC_GUIDE=on forces it on in any build (the bundles and achievements of the new chapter too), e.g. a deployed test site. Leave it empty otherwise. Public by design: it only switches a screen on.
NEXT_PUBLIC_GUIDE=

# End-to-end tests only (docs/ops/e2e-test-account.md). The password of the one test account (lepryko@gmail.com) in YOUR Supabase project.
# Put the value in .env.local (git-ignored), never in this file or anywhere that is committed. Leave it empty to sign in by hand when `npm run e2e` opens the browser.
E2E_TEST_PASSWORD=
