# Server-only (no NEXT_PUBLIC_): the browser never talks to Supabase, the /api/auth routes do.
# Project URL and the publishable (anon) key from Supabase > Settings > API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Needed for the cloud save: only the /api/save route may write the player_saves table.
# Supabase > Settings > API Keys > secret key. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=
