{
	"name": "idle-game",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "eslint . --max-warnings=0",
		"sim": "tsx scripts/sim.ts",
		"sim:parallel": "tsx scripts/sim-parallel.ts",
		"sim:local": "tsx scripts/sim-local.ts",
		"sim:classes": "tsx scripts/sim-classes.ts",
		"perf": "tsx scripts/perf-world.ts",
		"test": "tsx --test \"tests/**/*.test.ts\"",
		"report": "tsx scripts/balance-report.ts",
		"reset-test-account": "tsx scripts/reset-test-account.ts",
		"e2e": "playwright test",
		"stat-audit": "tsx scripts/stat-audit.ts",
		"reset-players": "tsx scripts/reset-players.ts",
		"check-live-saves": "tsx scripts/check-live-saves.ts",
		"restore-trust": "tsx scripts/restore-trust.ts",
		"migrate-saves": "tsx scripts/migrate-saves.ts",
		"seed-rehearsal": "tsx scripts/seed-rehearsal-account.ts",
		"seed-dev-world": "tsx scripts/seed-dev-world.ts",
		"gen-save-fixtures": "tsx scripts/gen-save-fixtures.ts",
		"fight-sim": "tsx scripts/fight-sim.ts",
		"perk-caps": "tsx scripts/perk-caps.ts",
		"monster-ladder": "tsx scripts/monster-ladder.ts",
		"catalog-report": "tsx scripts/catalog-report.ts",
		"loot-sim": "tsx scripts/loot-sim.ts",
		"kill-sim": "tsx scripts/kill-sim.ts",
		"craft-sim": "tsx scripts/craft-sim.ts",
		"docs:code": "tsx scripts/docs-reference.ts",
		"docs:code:check": "tsx scripts/docs-reference.ts --check",
		"docs:gen": "npm run docs:gen:rest && npm run docs:gen:sim && npm run docs:gen:hash",
		"docs:gen:rest": "npm run docs:gen:rest:quick && npm run docs:gen:rest:fights && npm run docs:gen:rest:loot",
		"docs:gen:rest:quick": "npm run report && npm run stat-audit && npm run catalog-report && npm run kill-sim -- --md && npm run craft-sim -- --md",
		"docs:gen:rest:fights": "npm run fight-sim -- --md && npm run monster-ladder -- --md",
		"docs:gen:rest:loot": "npm run loot-sim -- --md",
		"docs:gen:sim": "npm run sim:parallel",
		"docs:gen:hash": "tsx scripts/gen-inputs.ts --write",
		"docs:gen:fast": "tsx scripts/verify.ts --gen-only",
		"verify": "tsx scripts/verify.ts",
		"docs:check": "npm run docs:gen && git add -N docs/generated && git diff --exit-code docs/generated",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit .githooks/pre-push || exit 0",
		"assets:catalog": "tsx scripts/assets-catalog.ts",
		"assets:catalog:check": "tsx scripts/assets-catalog.ts --check",
		"storybook": "storybook dev -p 6007",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@fontsource-variable/mozilla-headline": "^5.3.0",
		"@fontsource/titan-one": "^5.3.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.118.0",
		"@tailwindcss/postcss": "^4.0.11",
		"@tanstack/react-query": "5.62.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.1.0",
		"clsx": "^2.1.1",
		"next": "15.5.28",
		"postcss": "^8.5.32",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwind-merge": "^3.0.2",
		"zustand": "^5.0.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@playwright/test": "1.65.0",
		"@storybook/addon-docs": "^10.6.6",
		"@storybook/nextjs-vite": "^10.6.6",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"esbuild": "^0.28.2",
		"eslint": "^9",
		"eslint-config-next": "15.5.28",
		"marked": "^14.1.4",
		"prettier": "3.3.3",
		"storybook": "^10.6.6",
		"tailwindcss": "^4.0.11",
		"tsx": "^4.23.15",
		"typescript": "^5",
		"vite": "^8.3.7"
	}
}
